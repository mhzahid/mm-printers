# ── Site ───────────────────────────────────────────────────────────
# Public URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.mmprinters.net

# Set to "false" on staging to send `Disallow: /` in robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Set to "true" on staging to show orange "Content needed before launch" notes.
# NEVER enable in production.
NEXT_PUBLIC_SHOW_CONTENT_GAPS=false

# ── Inquiry form delivery ──────────────────────────────────────────
# One of: laravel | smtp | log   (log works in development only)
# If unset, the form refuses submissions honestly (HTTP 503) and tells
# visitors to email or call instead. It never pretends to have sent.
INQUIRY_DRIVER=

# laravel driver — POSTs JSON to your Laravel API (see docs/laravel-inquiry-endpoint.md)
LARAVEL_INQUIRY_URL=https://api.mmprinters.net/api/inquiries
LARAVEL_INQUIRY_TOKEN=

# smtp driver — emails each inquiry to INQUIRY_TO_EMAIL (Reply-To is the visitor)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INQUIRY_FROM_EMAIL="MM Printers Website <no-reply@mmprinters.net>"
INQUIRY_TO_EMAIL=Info@mmprinters.net
